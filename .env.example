# ---------------------------------------------------------------- parse
# The capture box uses whichever of these is set. With neither, it falls back
# to the deterministic rule-based parser and the app still works end to end.

# OpenRouter (takes precedence)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=http://localhost:3000

# Anthropic direct
ANTHROPIC_API_KEY=

# --------------------------------------------------------------- digest
# Without a Resend key the digest is written to .digests/ and shown at /digest.
RESEND_API_KEY=
DIGEST_FROM="Personal CRM <onboarding@resend.dev>"

# Used for links inside the digest email.
APP_BASE_URL=http://localhost:3000

# ----------------------------------------------------------------- cron
# When set, /api/cron/* require `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# ------------------------------------------------------------- database
# Defaults to ./data/crm.db
# CRM_DB_PATH=
